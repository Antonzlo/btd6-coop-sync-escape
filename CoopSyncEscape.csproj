<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CoopSyncEscape</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Override with -p:BloonsTD6=<game folder> -->
    <BloonsTD6 Condition="'$(BloonsTD6)' == ''">$(HOME)/.local/share/Steam/steamapps/common/BloonsTD6</BloonsTD6>
    <Il2CppAssemblies>$(BloonsTD6)/MelonLoader/Il2CppAssemblies</Il2CppAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(BloonsTD6)/MelonLoader/net6/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BloonsTD6)/MelonLoader/net6/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BloonsTD6)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Il2CppAssemblies)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppAssemblies)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppAssemblies)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppAssemblies)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppAssemblies)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Btd6ModHelper"><HintPath>$(BloonsTD6)/Mods/Btd6ModHelper.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
